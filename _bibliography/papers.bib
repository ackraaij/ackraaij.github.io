@article{SZW2025_2027_1_1,
  selected={true},
  bibtex_show ={true},
  title={Waardoor verandert de ongelijkheid in marktinkomens? De rol van inkomen uit loon, winst en vermogen},
  author={Jongen, Egbert L. W. and Kraaij, Alexander C. and Vethaak, Heike T.},
  abstract={In opdracht van het Ministerie van Sociale Zaken en Werkgelegenheid heeft de afdeling Economie van de Universiteit Leiden onderzoek gedaan naar de ontwikkeling van ongelijkheid in marktinkomens in Nederland over de periode 1977–2024. Uit eerder onderzoek is gebleken dat er sprake is van polarisatie in de marktinkomens, waarbij het marktinkomen aan de onderkant is achtergebleven terwijl het marktinkomen van de top 1% juist relatief hard is gegroeid. Deze studie analyseert de drijfveren achter deze trend: inkomen uit loon, winst en vermogen. De studie laat zien dat loon de voornaamste reden was voor de toenemende polarisatie van het marktinkomen: de loongroei bleef achter bij de armere groepen, maar groeide juist relatief hard bij de top 1%. Daarnaast groeide het inkomen uit vermogen ook hard voor de top 1%, met name door dividend uit aanmerkelijk belang. Bij vrouwen is de ongelijkheid in het marktinkomen afgenomen sinds de jaren 80. Dit komt enerzijds doordat meer vrouwen in deze groep zijn gaan werken, en anderzijds omdat hun jaarlijkse inkomen (zowel als werknemer en als zelfstandige) is gestegen. Bij mannen is de ongelijkheid in het marktinkomen echter toegenomen. Dit komt met name door een toenemende ongelijkheid in het looninkomen. Aan de onderkant van de inkomensverdeling is het loon van mannen in reële termen (gecorrigeerd voor inflatie) zelfs gedaald, terwijl het loon van mannen aan de bovenkant juist bovengemiddeld is toegenomen.},
  journal={Department of Economics Research Memorandum no. 2026.01. Leiden University},
  location={Leiden},
  year={2026},
  url={https://www.universiteitleiden.nl/binaries/content/assets/rechtsgeleerdheid/fiscaal-en-economische-vakken/economie/rm_2026.01_website.pdf},
  html={https://www.universiteitleiden.nl/onderzoek/onderzoeksprojecten/rechtsgeleerdheid/waardoor-verandert-de-ongelijkheid-in-marktinkomens},
}
