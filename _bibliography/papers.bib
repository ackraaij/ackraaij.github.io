@article{https://doi.org/10.1002/csr.70794,
author = {Kraaij, Alexander C. and Paruzel, Agnieszka and de Jong, Arnoud},
title = {Firm-Level Corporate Social Responsibility and Employees' Affective Outcomes: A Multilevel Approach},
journal = {Corporate Social Responsibility and Environmental Management},
volume = {n/a},
number = {n/a},
pages = {},
keywords = {affective organizational commitment, corporate social responsibility, cross-level relationships, employee perceptions, hierarchical linear modeling, job satisfaction, multilevel modeling, work engagement},
doi = {https://doi.org/10.1002/csr.70794},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/csr.70794},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/csr.70794},
abstract = {ABSTRACT This study advances research on corporate social responsibility (CSR) and employees' work attitudes by distinguishing between employee-level CSR perceptions and firm-level CSR practices. Prior research has mainly focused on how employees' perceptions of CSR relate to their affective outcomes; this study extends that perspective by jointly examining both levels to clarify their distinct and interrelated associations. Using a multilevel framework, we analyzed the relationships between firm-level CSR practices—charitable donations, employee volunteering, diversity and equal opportunity promotion, and the integration of ethical values into selection and promotion—and employees' CSR perceptions regarding donations, goals, and discrimination. We then related these to three affective outcomes: work engagement, job satisfaction, and affective organizational commitment. Hierarchical linear modeling was applied to data from 1419 employees across 355 German establishments. The findings revealed weak associations between firm-level CSR practices and employee-level CSR perceptions except for donations, and limited evidence of a direct positive cross-level relationship between firm-level CSR practices and affective outcomes. In contrast, employees' CSR perceptions were consistently and positively related to all three affective outcomes. CSR perceptions did not mediate the relationship between CSR practices and affective outcomes. These results highlight that employees' subjective CSR perceptions differ from firms' objective CSR practices. The study emphasizes the need to distinguish between perceptions and practices in future CSR research and warns against relying solely on perceptions as proxies for organizational CSR engagement.}
}


@article{SZW2025_2027_1_1,
  selected={true},
  bibtex_show ={true},
  title={Waardoor verandert de ongelijkheid in marktinkomens? De rol van inkomen uit loon, winst en vermogen},
  author={Jongen, Egbert L. W. and Kraaij, Alexander C. and Vethaak, Heike T.},
  abstract={In opdracht van het Ministerie van Sociale Zaken en Werkgelegenheid heeft de afdeling Economie van de Universiteit Leiden onderzoek gedaan naar de ontwikkeling van ongelijkheid in marktinkomens in Nederland over de periode 1977–2024. Uit eerder onderzoek is gebleken dat er sprake is van polarisatie in de marktinkomens, waarbij het marktinkomen aan de onderkant is achtergebleven terwijl het marktinkomen van de top 1% juist relatief hard is gegroeid. Deze studie analyseert de drijfveren achter deze trend: inkomen uit loon, winst en vermogen. De studie laat zien dat loon de voornaamste reden was voor de toenemende polarisatie van het marktinkomen: de loongroei bleef achter bij de armere groepen, maar groeide juist relatief hard bij de top 1%. Daarnaast groeide het inkomen uit vermogen ook hard voor de top 1%, met name door dividend uit aanmerkelijk belang. Bij vrouwen is de ongelijkheid in het marktinkomen afgenomen sinds de jaren 80. Dit komt enerzijds doordat meer vrouwen in deze groep zijn gaan werken, en anderzijds omdat hun jaarlijkse inkomen (zowel als werknemer en als zelfstandige) is gestegen. Bij mannen is de ongelijkheid in het marktinkomen echter toegenomen. Dit komt met name door een toenemende ongelijkheid in het looninkomen. Aan de onderkant van de inkomensverdeling is het loon van mannen in reële termen (gecorrigeerd voor inflatie) zelfs gedaald, terwijl het loon van mannen aan de bovenkant juist bovengemiddeld is toegenomen.},
  journal={Department of Economics Research Memorandum no. 2026.01. Leiden University},
  location={Leiden},
  year={2026},
  url={https://www.universiteitleiden.nl/binaries/content/assets/rechtsgeleerdheid/fiscaal-en-economische-vakken/economie/rm_2026.01_website.pdf},
  html={https://www.universiteitleiden.nl/onderzoek/onderzoeksprojecten/rechtsgeleerdheid/waardoor-verandert-de-ongelijkheid-in-marktinkomens},
}
